<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-kaelen" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#10b981" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-kaelen" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#10b981" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-kaelen)"/>
    
    <!-- Character Artwork -->
    
      <!-- Culvert Poncho & Dual Optics -->
      <circle cx="160" cy="160" r="140" fill="#0d1411" stroke="#10b981" stroke-width="3" opacity="0.5"/>
      <!-- Hood & Poncho -->
      <path d="M 85 285 Q 160 160 235 285 Z" fill="#132a22" stroke="#10b981" stroke-width="2"/>
      <circle cx="160" cy="135" r="38" fill="#061f17"/>
      <path d="M 122 135 Q 160 75 198 135 Z" fill="#0b3d2e" stroke="#10b981" stroke-width="1.5"/>
      <!-- Dual Goggle Lenses -->
      <circle cx="148" cy="135" r="9" fill="#022c22" stroke="#38bdf8" stroke-width="2"/>
      <circle cx="148" cy="135" r="4" fill="#38bdf8"/>
      <circle cx="172" cy="135" r="9" fill="#022c22" stroke="#38bdf8" stroke-width="2"/>
      <circle cx="172" cy="135" r="4" fill="#38bdf8"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-kaelen)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#10b981" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#10b981" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#10b981" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#10b981" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#10b981" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">KAELEN // "WISP"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">SILENT SCOUT</text>
  </svg>