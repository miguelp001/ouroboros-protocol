<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-valerius" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-valerius" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#8b5cf6" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-valerius)"/>
    
    <!-- Character Artwork -->
    
      <!-- Pinstripe Suit & Cybernetic Gold Tooth -->
      <circle cx="160" cy="160" r="140" fill="#120f1a" stroke="#8b5cf6" stroke-width="3" opacity="0.5"/>
      <!-- Tailored Coat -->
      <path d="M 95 285 L 135 185 L 185 185 L 225 285 Z" fill="#1e182f" stroke="#8b5cf6" stroke-width="2"/>
      <line x1="130" y1="200" x2="130" y2="285" stroke="#3b2d59" stroke-width="1.5" stroke-dasharray="4 4"/>
      <line x1="190" y1="200" x2="190" y2="285" stroke="#3b2d59" stroke-width="1.5" stroke-dasharray="4 4"/>
      <!-- Slick Head & Monocle / Gold Glint -->
      <circle cx="160" cy="140" r="38" fill="#18181b"/>
      <path d="M 125 130 Q 160 90 195 130 Z" fill="#2e1065"/>
      <!-- Gold Tooth Glint in Smile -->
      <path d="M 148 162 Q 160 172 172 162" fill="none" stroke="#d4d4d8" stroke-width="2"/>
      <polygon points="163,165 167,163 165,168" fill="#facc15"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-valerius)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#8b5cf6" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#8b5cf6" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#8b5cf6" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#8b5cf6" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#8b5cf6" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">VALERIUS // "DIPLOMAT"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">FALLEN SYNDICATE BROKER</text>
  </svg>