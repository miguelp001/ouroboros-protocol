<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-agent_zero" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#facc15" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-agent_zero" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#facc15" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-agent_zero)"/>
    
    <!-- Character Artwork -->
    
      <!-- Ouroboros Emblem & Noir Silhouette -->
      <circle cx="160" cy="160" r="140" fill="#0d0d11" stroke="#facc15" stroke-width="3" stroke-dasharray="12 4" opacity="0.6"/>
      <!-- Shrouded Coat & Cowl -->
      <path d="M 90 280 L 160 170 L 230 280 Z" fill="#18181b" stroke="#facc15" stroke-width="2"/>
      <path d="M 120 280 L 160 200 L 200 280 Z" fill="#27272a"/>
      <!-- Hat / Cowl Brim -->
      <ellipse cx="160" cy="140" rx="65" ry="14" fill="#09090b" stroke="#facc15" stroke-width="2"/>
      <path d="M 115 140 Q 160 85 205 140 Z" fill="#18181b" stroke="#facc15" stroke-width="1.5"/>
      <!-- Glowing Eyes / Amber Slate Reflection -->
      <ellipse cx="145" cy="155" rx="5" ry="2.5" fill="#facc15" opacity="0.9"/>
      <ellipse cx="175" cy="155" rx="5" ry="2.5" fill="#facc15" opacity="0.9"/>
      <!-- Ouroboros Snake Ring Crest -->
      <circle cx="160" cy="245" r="24" fill="none" stroke="#facc15" stroke-width="3"/>
      <path d="M 160 221 A 24 24 0 1 1 159.9 221" fill="none" stroke="#38bdf8" stroke-width="2" stroke-dasharray="8 4"/>
      <polygon points="160,217 166,225 154,225" fill="#facc15"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-agent_zero)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#facc15" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#facc15" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#facc15" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#facc15" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#facc15" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">AGENT 0 // "CIPHER"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">AGENCY DIRECTOR</text>
  </svg>