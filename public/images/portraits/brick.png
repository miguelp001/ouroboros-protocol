<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-brick" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ef4444" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-brick" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#ef4444" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-brick)"/>
    
    <!-- Character Artwork -->
    
      <!-- Colossal Shoulders & Hydraulic Plate -->
      <circle cx="160" cy="160" r="140" fill="#120e0e" stroke="#ef4444" stroke-width="3" opacity="0.5"/>
      <!-- Massive Heavy Pauldron Left -->
      <rect x="70" y="180" width="60" height="90" rx="8" fill="#1f1a1a" stroke="#ef4444" stroke-width="2.5"/>
      <line x1="85" y1="195" x2="115" y2="195" stroke="#ef4444" stroke-width="3"/>
      <!-- Hydraulic Armature Right -->
      <rect x="190" y="180" width="60" height="90" rx="8" fill="#292020" stroke="#f97316" stroke-width="2.5"/>
      <line x1="220" y1="180" x2="220" y2="260" stroke="#f97316" stroke-width="4"/>
      <!-- Square Head & Jaw -->
      <rect x="135" y="105" width="50" height="58" rx="6" fill="#262626" stroke="#525252" stroke-width="2"/>
      <!-- Red Cybernetic Visor -->
      <rect x="138" y="125" width="44" height="10" fill="#ef4444"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-brick)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#ef4444" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#ef4444" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#ef4444" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#ef4444" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#ef4444" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">"BRICK" // "BASTION"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">AUGMENTED JUGGERNAUT</text>
  </svg>