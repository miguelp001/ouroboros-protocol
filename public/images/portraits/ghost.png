<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-ghost" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ec4899" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-ghost" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#ec4899" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-ghost)"/>
    
    <!-- Character Artwork -->
    
      <!-- Chromatic Aberration & Translucent Cowl -->
      <circle cx="160" cy="160" r="140" fill="#170d14" stroke="#ec4899" stroke-width="3" stroke-dasharray="10 6" opacity="0.6"/>
      <!-- Ghost Shroud -->
      <path d="M 90 285 Q 160 140 230 285 Z" fill="#2d1222" opacity="0.75" stroke="#ec4899" stroke-width="2"/>
      <!-- Chromatic Ghost Offset -->
      <path d="M 85 285 Q 155 140 225 285 Z" fill="none" stroke="#38bdf8" stroke-width="1.5" opacity="0.5"/>
      <!-- Silver Eyes -->
      <circle cx="145" cy="145" r="6" fill="#f1f5f9" stroke="#38bdf8" stroke-width="1.5"/>
      <circle cx="175" cy="145" r="6" fill="#f1f5f9" stroke="#ec4899" stroke-width="1.5"/>
      <!-- Tachyon Waves -->
      <path d="M 120 180 Q 160 195 200 180" fill="none" stroke="#38bdf8" stroke-width="2" opacity="0.8"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-ghost)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#ec4899" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#ec4899" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#ec4899" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#ec4899" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#ec4899" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">"GHOST" // "SPECTRE"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">ANOMALOUS PHANTOM</text>
  </svg>