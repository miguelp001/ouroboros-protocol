<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-sgt_graves" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#eab308" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-sgt_graves" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#eab308" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-sgt_graves)"/>
    
    <!-- Character Artwork -->
    
      <!-- Tactical Armored Vest & Eyepatch -->
      <circle cx="160" cy="160" r="140" fill="#14120c" stroke="#eab308" stroke-width="3" opacity="0.5"/>
      <path d="M 95 285 L 125 185 L 195 185 L 225 285 Z" fill="#282315" stroke="#eab308" stroke-width="2"/>
      <!-- Scratched Insignia -->
      <line x1="150" y1="215" x2="170" y2="235" stroke="#ef4444" stroke-width="2"/>
      <line x1="170" y1="215" x2="150" y2="235" stroke="#ef4444" stroke-width="2"/>
      <!-- Head & Eyepatch -->
      <circle cx="160" cy="140" r="40" fill="#1c1917" stroke="#78716c" stroke-width="2"/>
      <line x1="135" y1="125" x2="175" y2="145" stroke="#000" stroke-width="3"/>
      <polygon points="165,135 175,145 168,152 158,142" fill="#09090b" stroke="#78716c"/>
      <!-- Glowing Target Eye -->
      <circle cx="148" cy="138" r="4" fill="#facc15"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-sgt_graves)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#eab308" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#eab308" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#eab308" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#eab308" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#eab308" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">SGT. GRAVES // "IRONCLAD"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">REDOUBT VETERAN</text>
  </svg>