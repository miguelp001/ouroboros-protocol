<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-dr_lin" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-dr_lin" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#06b6d4" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-dr_lin)"/>
    
    <!-- Character Artwork -->
    
      <!-- Medical Apron & Headlamp -->
      <circle cx="160" cy="160" r="140" fill="#091417" stroke="#06b6d4" stroke-width="3" opacity="0.5"/>
      <rect x="110" y="195" width="100" height="90" rx="6" fill="#164e63" stroke="#06b6d4" stroke-width="2"/>
      <!-- Medical Caduceus / Cross -->
      <rect x="155" y="215" width="10" height="26" fill="#ef4444"/>
      <rect x="147" y="223" width="26" height="10" fill="#ef4444"/>
      <!-- Head & Surgical Mask -->
      <circle cx="160" cy="140" r="38" fill="#155e75"/>
      <rect x="142" y="145" width="36" height="20" rx="4" fill="#e0f2fe" opacity="0.9"/>
      <!-- Surgical Headlamp -->
      <circle cx="160" cy="105" r="9" fill="#083344" stroke="#06b6d4" stroke-width="2"/>
      <circle cx="160" cy="105" r="5" fill="#facc15"/>
      <polygon points="160,105 130,50 190,50" fill="#facc15" opacity="0.15"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-dr_lin)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#06b6d4" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#06b6d4" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#06b6d4" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#06b6d4" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#06b6d4" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">DR. LIN // "SCALPEL"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">TRAUMA SURGEON</text>
  </svg>