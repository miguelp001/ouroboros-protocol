<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
    <defs>
      <radialGradient id="bgGlow-elias_thorne" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#a1a1aa" stop-opacity="0.2"/>
        <stop offset="100%" stop-color="#0a0a0c" stop-opacity="1"/>
      </radialGradient>
      <linearGradient id="crtScan-elias_thorne" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="transparent"/>
        <stop offset="50%" stop-color="#a1a1aa" stop-opacity="0.05"/>
        <stop offset="100%" stop-color="transparent"/>
      </linearGradient>
    </defs>
    <!-- Background Frame -->
    <rect width="320" height="320" fill="#0a0a0c"/>
    <rect width="320" height="320" fill="url(#bgGlow-elias_thorne)"/>
    
    <!-- Character Artwork -->
    
      <!-- Fedora & Trench Coat -->
      <circle cx="160" cy="160" r="140" fill="#0d0d11" stroke="#a1a1aa" stroke-width="3" opacity="0.5"/>
      <!-- Trench Coat -->
      <path d="M 95 285 L 140 185 L 180 185 L 225 285 Z" fill="#27272a" stroke="#71717a" stroke-width="2"/>
      <line x1="160" y1="210" x2="160" y2="285" stroke="#3f3f46" stroke-width="2"/>
      <polygon points="160,205 155,240 165,240" fill="#facc15" opacity="0.6"/>
      <!-- Face & Fedora -->
      <circle cx="160" cy="145" r="38" fill="#18181b"/>
      <ellipse cx="160" cy="125" rx="55" ry="12" fill="#18181b" stroke="#a1a1aa" stroke-width="2"/>
      <path d="M 120 125 Q 160 85 200 125 Z" fill="#27272a" stroke="#a1a1aa" stroke-width="2"/>
      <!-- E-Cigarette Smoke -->
      <rect x="168" y="165" width="18" height="4" fill="#d4d4d8"/>
      <circle cx="186" cy="167" r="2.5" fill="#f97316"/>
      <path d="M 190 165 Q 205 145 220 150 Q 235 155 240 130" fill="none" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3" opacity="0.7"/>
    

    <!-- Scanline Overlay -->
    <rect width="320" height="320" fill="url(#crtScan-elias_thorne)" pointer-events="none"/>

    <!-- CRT Corner Brackets -->
    <path d="M 15 35 L 15 15 L 35 15" fill="none" stroke="#a1a1aa" stroke-width="2"/>
    <path d="M 305 35 L 305 15 L 285 15" fill="none" stroke="#a1a1aa" stroke-width="2"/>
    <path d="M 15 285 L 15 305 L 35 305" fill="none" stroke="#a1a1aa" stroke-width="2"/>
    <path d="M 305 285 L 305 305 L 285 305" fill="none" stroke="#a1a1aa" stroke-width="2"/>

    <!-- Callsign Plate -->
    <rect x="25" y="278" width="270" height="26" rx="4" fill="#09090b" stroke="#27272a" stroke-width="1.5"/>
    <text x="35" y="295" fill="#a1a1aa" font-family="monospace" font-size="11" font-weight="bold" letter-spacing="0.1em">ELIAS THORNE // "GREY FOX"</text>
    <text x="285" y="295" fill="#71717a" font-family="monospace" font-size="9" text-anchor="end">DISGRACED DETECTIVE</text>
  </svg>